<ui:FluentWindow x:Class="Lumina.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:Lumina"
        Title="Lumina" Icon="pack://application:,,,/Assets/Brand/lumina.ico" Width="1366" Height="820" MinWidth="1000" MinHeight="640" AllowDrop="True"
        Background="{DynamicResource Lumina.Brush.Bg}" FontFamily="{StaticResource Lumina.Font.Text}" WindowBackdropType="None" ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen" Drop="OnDrop">

    <Window.Resources>
        <!-- Folder row on the Folders page -->
        <DataTemplate x:Key="FolderRow" DataType="{x:Type app:FolderRow}">
            <Grid Margin="0,0,0,0" MinHeight="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Lumina.Brush.AccentDim}" Margin="16,0,14,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="{DynamicResource Lumina.Brush.Accent}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10">
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Lumina.Text.Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Lumina.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <Button Content="Subtitles" Style="{StaticResource Lumina.Btn.Secondary}" Margin="0,0,8,0" Click="OnFolderSubs" AutomationProperties.Name="Find subtitles for this folder" />
                    <Button Content="{Binding LockText}" Style="{StaticResource Lumina.Btn.Secondary}" Margin="0,0,8,0" Click="OnLockFolder"
                            AutomationProperties.Name="{Binding LockName}" />
                    <Button Content="Remove" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnRemoveFolder" AutomationProperties.Name="Remove folder" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Saved playlist row on the Playlists page -->
        <DataTemplate x:Key="PlaylistRow" DataType="{x:Type app:PlaylistRow}">
            <Grid MinHeight="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Lumina.Brush.AccentDim}" Margin="16,0,14,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="20" Foreground="{DynamicResource Lumina.Brush.Accent}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Lumina.Text.Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Info}" Style="{StaticResource Lumina.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,16,0" VerticalAlignment="Center">
                    <Button Content="Play" Style="{StaticResource Lumina.Btn.Primary}" Click="OnPlaylistPlay" AutomationProperties.Name="{Binding PlayName}" />
                    <Button Content="Subtitles" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnPlaylistSubs" Margin="8,0,0,0" AutomationProperties.Name="{Binding SubsName}" />
                    <Button Content="Rename" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnPlaylistRename" Margin="8,0,0,0" AutomationProperties.Name="{Binding RenameName}" />
                    <Button Content="Delete" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnPlaylistDelete" Margin="8,0,0,0" AutomationProperties.Name="{Binding DeleteName}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChipTemplate">
            <Border CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="#66000000" BorderThickness="1" BorderBrush="#33FFFFFF" Padding="12,4" Margin="0,0,8,8">
                <TextBlock Text="{Binding}" Style="{StaticResource Lumina.Text}" FontSize="{StaticResource Lumina.FontSize.Caption}" />
            </Border>
        </DataTemplate>
        <LinearGradientBrush x:Key="Lumina.Gradient.Orange" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8542B" Offset="0" /><GradientStop Color="#F2A33A" Offset="1" /></LinearGradientBrush>
        <LinearGradientBrush x:Key="Lumina.Gradient.Blue" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2147E0" Offset="0" /><GradientStop Color="#4FC0F2" Offset="1" /></LinearGradientBrush>
        <LinearGradientBrush x:Key="Lumina.Gradient.Pink" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E83A55" Offset="0" /><GradientStop Color="#C84FE0" Offset="1" /></LinearGradientBrush>
        <LinearGradientBrush x:Key="Lumina.Gradient.Green" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2E9B2E" Offset="0" /><GradientStop Color="#9BE24F" Offset="1" /></LinearGradientBrush>
        <DataTemplate x:Key="CastTemplate">
            <StackPanel Width="100" Margin="0,0,12,0" AutomationProperties.Name="{Binding Label}">
                <Border Width="88" Height="88" CornerRadius="16" HorizontalAlignment="Left" Background="{DynamicResource Lumina.Brush.SurfaceRaised}"
                        BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}">
                    <Border CornerRadius="15">
                        <Border.Background><ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" /></Border.Background>
                        <TextBlock Text="{Binding Initials}" Visibility="{Binding InitialsShown}" Style="{StaticResource Lumina.Text.Muted}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Border>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Lumina.Text.Label}" FontSize="13" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Role}" Style="{StaticResource Lumina.Text.Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text.Label}" />
        <Style x:Key="SettingHelp" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="{StaticResource Lumina.Grid.Sidebar}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the pages sit on a solid page colour; only the sidebar is allowed to be translucent -->
        <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Lumina.Brush.Bg}" />

        <!-- Out of playback the title bar is only the window buttons at the right, so the page's own controls under the top edge stay clickable; the strip above moves the window. -->
        <ui:TitleBar x:Name="Bar" Grid.ColumnSpan="2" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Right" Width="170" Height="32" Panel.ZIndex="5" Title="" Background="Transparent" />
        <Border x:Name="DragStrip" Grid.ColumnSpan="2" Height="12" VerticalAlignment="Top" Background="Transparent" Panel.ZIndex="5" MouseLeftButtonDown="OnDragStrip" />

        <!-- ================= Sidebar ================= -->
        <Border x:Name="Sidebar" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource Lumina.Brush.Sidebar}" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource Lumina.Brush.Border}">
            <Grid x:Name="SidebarGrid" Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="BrandRow" Margin="12,6,0,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="Brand" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Image Source="{StaticResource Lumina.Brand.Mark}" Width="30" Height="30" VerticalAlignment="Center" AutomationProperties.Name="Lumina logo" />
                        <TextBlock x:Name="Wordmark" Text="Lumina" Margin="10,0,0,0" FontFamily="{StaticResource Lumina.Font.Display}" FontSize="19"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Lumina.Brush.Text}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CompactToggle" Style="{StaticResource Lumina.Btn.Icon}" Width="30" Height="30" MinHeight="30" HorizontalAlignment="Right"
                            Click="OnCompactToggle" AutomationProperties.Name="Collapse sidebar" ToolTip="Collapse sidebar">
                        <ui:SymbolIcon x:Name="CompactGlyph" Symbol="PanelLeftContract20" FontSize="16" />
                    </Button>
                </Grid>

                <Button x:Name="SearchCompact" Grid.Row="1" Style="{StaticResource Lumina.Btn.Icon}" Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,16"
                        Visibility="Collapsed" Click="OnSearchCompact" AutomationProperties.Name="Search your library" ToolTip="Search">
                    <ui:SymbolIcon Symbol="Search20" FontSize="17" />
                </Button>

                <Grid x:Name="SearchField" Grid.Row="1" Margin="0,0,0,16">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Lumina.Search}" TextChanged="OnSearchChanged"
                             AutomationProperties.Name="Search your library" />
                    <ui:SymbolIcon Symbol="Search20" FontSize="16" Foreground="{DynamicResource Lumina.Brush.TextMuted}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text.Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Row="2">
                    <RadioButton x:Name="NavHome" Content="Home" GroupName="nav" IsChecked="True" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="home">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="Home24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavMovies" Content="Movies" GroupName="nav" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="movies">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="VideoClip24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavShows" Content="TV shows" GroupName="nav" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="shows">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="Tv24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavUnwatched" Content="Unwatched" GroupName="nav" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="unwatched">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="EyeOff24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>

                    <Border Height="1" Background="{DynamicResource Lumina.Brush.Border}" Margin="12,14,12,14" />

                    <RadioButton x:Name="NavPlaylists" Content="Playlists" GroupName="nav" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="playlists">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavFolders" Content="Folders" GroupName="nav" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="folders">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Content="Settings" GroupName="nav" Style="{StaticResource Lumina.Nav.Item}" Click="OnNav" CommandParameter="settings">
                        <RadioButton.Tag><ui:SymbolIcon Symbol="Settings24" FontSize="18" /></RadioButton.Tag>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <!-- scan activity: a short bar sweeping across, only while work is running -->
                    <Grid x:Name="ScanBar" Height="3" Margin="12,0,12,10" ClipToBounds="True" Visibility="Collapsed">
                        <Border Background="{DynamicResource Lumina.Brush.Border}" CornerRadius="1.5" />
                        <Border Width="70" HorizontalAlignment="Left" Background="{DynamicResource Lumina.Brush.Accent}" CornerRadius="1.5">
                            <Border.RenderTransform><TranslateTransform x:Name="ScanSweep" X="-70" /></Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ScanSweep" Storyboard.TargetProperty="X" From="-70" To="220" Duration="0:0:1.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="Status" Style="{StaticResource Lumina.Text.Caption}" TextWrapping="Wrap" Margin="12,0,12,10" />
                    <Button x:Name="TraktBtn" Style="{StaticResource Lumina.Btn.Link}" Click="OnTrakt" HorizontalAlignment="Left" Margin="4,0,0,0" AutomationProperties.Name="{Binding Text, ElementName=TraktText}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="TraktIcon" Symbol="PlugDisconnected24" FontSize="17" Margin="0,0,8,0" />
                            <TextBlock x:Name="TraktText" Text="Connect Trakt" Style="{StaticResource Lumina.Text}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Sync now" Click="OnTraktSync" />
                                <MenuItem Header="Disconnect" Click="OnTraktDisconnect" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid x:Name="Pages" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="0,12,0,0" Focusable="True" FocusVisualStyle="{x:Null}">

            <!-- Home -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="36,10,36,48">
                    <Grid Margin="0,0,170,22">
                        <TextBlock Text="Home" Style="{StaticResource Lumina.Text.Page}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource Lumina.Btn.Icon}" Click="OnRescan" ToolTip="Rescan folders" AutomationProperties.Name="Rescan folders">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="18" />
                            </Button>
                            <Button Content="Open file" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnOpen" Margin="10,0,0,0" />
                            <Button Content="Open stream" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnOpenStream" Margin="10,0,0,0" ToolTip="Play a web address (Ctrl+U)" />
                        </StackPanel>
                    </Grid>

                    <!-- shown when there is no TMDB key, so posters are missing for a reason the user can fix -->
                    <Border x:Name="KeyBanner" Visibility="Collapsed" Style="{StaticResource Lumina.Group}" Padding="18,14" Margin="0,0,0,26">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Posters need a TMDB key" Style="{StaticResource Lumina.Text.Label}" />
                                <TextBlock Text="Add a free key in Settings and Lumina fills in artwork, summaries and episode names." Style="{StaticResource Lumina.Text.Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Settings" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnBannerSettings" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="HomeRows">
                        <app:Shelf x:Name="ShelfContinue" Title="Continue watching" ShowSeeAll="False" />

                        <UniformGrid x:Name="Tiles" Columns="4" Margin="0,0,0,40" Visibility="Collapsed">
                            <Button x:Name="TileMovies" Style="{StaticResource Lumina.Btn.Tile}" Click="OnTile" CommandParameter="movies" Margin="0,0,14,0" AutomationProperties.Name="Movies">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Lumina.Gradient.Blue}">
                                        <ui:SymbolIcon Symbol="VideoClip24" FontSize="22" Foreground="White" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Movies" Style="{StaticResource Lumina.Text.Label}" />
                                        <TextBlock x:Name="TileMoviesCount" Style="{StaticResource Lumina.Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TileShows" Style="{StaticResource Lumina.Btn.Tile}" Click="OnTile" CommandParameter="shows" Margin="0,0,14,0" AutomationProperties.Name="TV shows">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Lumina.Gradient.Pink}">
                                        <ui:SymbolIcon Symbol="Tv24" FontSize="22" Foreground="White" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="TV shows" Style="{StaticResource Lumina.Text.Label}" />
                                        <TextBlock x:Name="TileShowsCount" Style="{StaticResource Lumina.Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Lumina.Btn.Tile}" Click="OnTile" CommandParameter="unwatched" Margin="0,0,14,0" AutomationProperties.Name="Unwatched">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Lumina.Gradient.Orange}">
                                        <ui:SymbolIcon Symbol="EyeOff24" FontSize="22" Foreground="White" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Unwatched" Style="{StaticResource Lumina.Text.Label}" />
                                        <TextBlock x:Name="TileUnwatchedCount" Style="{StaticResource Lumina.Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Lumina.Btn.Tile}" Click="OnTile" CommandParameter="folders" AutomationProperties.Name="Folders">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Lumina.Gradient.Green}">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="22" Foreground="White" />
                                    </Border>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Folders" Style="{StaticResource Lumina.Text.Label}" />
                                        <TextBlock x:Name="TileFoldersCount" Style="{StaticResource Lumina.Text.Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <app:Shelf x:Name="ShelfFavourites" Title="Favourites" />
                        <app:Shelf x:Name="ShelfRecent" Title="Recently added" />
                        <app:Shelf x:Name="ShelfFilmGenres" Title="Film genres" ShowSeeAll="False" CardTemplate="{StaticResource Lumina.GenreTile}" />
                        <app:Shelf x:Name="ShelfShowGenres" Title="TV genres" ShowSeeAll="False" CardTemplate="{StaticResource Lumina.GenreTile}" />
                        <app:Shelf x:Name="ShelfUnwatched" Title="Unwatched" />
                        <app:Shelf x:Name="ShelfTopRated" Title="Top rated films" />
                        <app:Shelf x:Name="ShelfMovies" Title="Movies" />
                        <app:Shelf x:Name="ShelfShows" Title="TV shows" />
                    </StackPanel>

                    <!-- Empty library: a clear next step instead of a blank page -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,70,0,0" MaxWidth="460">
                        <Border Width="84" Height="84" CornerRadius="22" Background="{DynamicResource Lumina.Brush.AccentDim}" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="38" Foreground="{DynamicResource Lumina.Brush.Accent}" />
                        </Border>
                        <TextBlock Text="Nothing here yet" Style="{StaticResource Lumina.Text.Page}" TextAlignment="Center" Margin="0,24,0,0" />
                        <TextBlock Text="Point Lumina at a folder of movies and shows. It reads the file names and finds artwork and episode titles on its own."
                                   Style="{StaticResource Lumina.Text.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" LineHeight="21" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                            <Button Content="Add a folder" Style="{StaticResource Lumina.Btn.Primary}" Click="OnAddFolder" />
                            <Button Content="Open a file" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnOpen" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="You can also drop a video anywhere in this window." Style="{StaticResource Lumina.Text.Caption}" TextAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Library (movies, shows, unwatched, search results) -->
            <ScrollViewer x:Name="LibraryPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="36,10,36,48">
                    <Grid Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LibTitle" Style="{StaticResource Lumina.Text.Page}" />
                            <TextBlock x:Name="LibCount" Style="{StaticResource Lumina.Text.Muted}" VerticalAlignment="Bottom" Margin="14,0,0,5" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,26">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton x:Name="FilterAll" Content="All" GroupName="filter" IsChecked="True" Style="{StaticResource Lumina.Seg.Item}" Click="OnLibraryFilter" />
                            <RadioButton x:Name="FilterUnwatched" Content="Unwatched" GroupName="filter" Style="{StaticResource Lumina.Seg.Item}" Click="OnLibraryFilter" />
                            <RadioButton x:Name="FilterProgress" Content="In progress" GroupName="filter" Style="{StaticResource Lumina.Seg.Item}" Click="OnLibraryFilter" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ComboBox x:Name="SortBox" Width="200" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="Sort by"
                                      SelectionChanged="OnSortChanged" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <RadioButton x:Name="ViewGrid" GroupName="view" Style="{StaticResource Lumina.Seg.Item}" Click="OnViewChanged" ToolTip="Posters" AutomationProperties.Name="Poster view">
                                <ui:SymbolIcon Symbol="Grid24" FontSize="18" />
                            </RadioButton>
                            <RadioButton x:Name="ViewList" GroupName="view" Style="{StaticResource Lumina.Seg.Item}" Click="OnViewChanged" ToolTip="List" AutomationProperties.Name="List view">
                                <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="18" />
                            </RadioButton>
                            <RadioButton x:Name="SizeS" GroupName="size" Content="S" Style="{StaticResource Lumina.Seg.Item}" Click="OnSizeChanged" AutomationProperties.Name="Small posters" Margin="10,0,0,0" />
                            <RadioButton x:Name="SizeM" GroupName="size" Content="M" Style="{StaticResource Lumina.Seg.Item}" Click="OnSizeChanged" AutomationProperties.Name="Medium posters" />
                            <RadioButton x:Name="SizeL" GroupName="size" Content="L" Style="{StaticResource Lumina.Seg.Item}" Click="OnSizeChanged" AutomationProperties.Name="Large posters" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LibGrid" Style="{StaticResource Lumina.Grid.List}" ItemTemplate="{StaticResource Lumina.PosterCard}"
                             app:ScrollForward.Enabled="True" PreviewMouseLeftButtonUp="OnGridClick" KeyDown="OnGridKey" />
                    <ListBox x:Name="LibList" Style="{StaticResource Lumina.Row.List}" ItemTemplate="{StaticResource Lumina.EntryRow}" Visibility="Collapsed"
                             app:ScrollForward.Enabled="True" PreviewMouseLeftButtonUp="OnListClick" KeyDown="OnListKey" />
                    <StackPanel x:Name="LibEmpty" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,60,0,0">
                        <ui:SymbolIcon Symbol="Search24" FontSize="36" Foreground="{DynamicResource Lumina.Brush.TextFaint}" />
                        <TextBlock x:Name="LibEmptyText" Style="{StaticResource Lumina.Text.Muted}" TextAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Details (a movie or a show) -->
            <ScrollViewer x:Name="DetailsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Grid x:Name="DHero" Height="580">
                        <Border x:Name="DBackdropBorder" Background="{DynamicResource Lumina.Brush.Surface}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF000000" Offset="0.55" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Image x:Name="DBackdrop" Stretch="UniformToFill" VerticalAlignment="Top" />
                        </Border>
                        <!-- left-to-right shade so the title stays readable over bright artwork -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource Lumina.Color.BgA90}" Offset="0" />
                                    <GradientStop Color="{DynamicResource Lumina.Color.BgA60}" Offset="0.45" />
                                    <GradientStop Color="{DynamicResource Lumina.Color.BgA0}" Offset="0.85" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Button Style="{StaticResource Lumina.Btn.Glass}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,14,0,0"
                                Click="OnDetailsBack" ToolTip="Back" AutomationProperties.Name="Back">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" Foreground="White" />
                        </Button>
                        <Grid VerticalAlignment="Bottom" Margin="44,0,44,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <Image x:Name="DLogo" MaxHeight="130" MaxWidth="340" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,0,18"
                                       AutomationProperties.Name="Title logo" />
                                <TextBlock x:Name="DTitle" Style="{StaticResource Lumina.Text.Display}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <Button x:Name="DPlay" Style="{StaticResource Lumina.Btn.Primary}" Click="OnDetailsPlay" HorizontalAlignment="Stretch" MinHeight="48">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="18" Margin="0,0,10,0" />
                                        <TextBlock x:Name="DPlayText" />
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="DProgressBlock" Margin="4,10,4,0" Visibility="Collapsed">
                                    <ProgressBar x:Name="DProgress" Style="{StaticResource Lumina.Progress}" Height="4" Background="{DynamicResource Lumina.Brush.BorderInput}" />
                                    <TextBlock x:Name="DProgressText" Style="{StaticResource Lumina.Text.Caption}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="DActions" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="DWatched" Style="{StaticResource Lumina.Btn.Icon}" Width="46" Height="46" Margin="0,0,10,0" Click="OnDetailsWatched">
                                        <ui:SymbolIcon x:Name="DWatchedIcon" Symbol="Eye24" FontSize="20" />
                                    </Button>
                                    <Button x:Name="DFavourite" Style="{StaticResource Lumina.Btn.Icon}" Width="46" Height="46" Margin="0,0,10,0" Click="OnDetailsFavourite">
                                        <ui:SymbolIcon x:Name="DFavouriteIcon" Symbol="Star24" FontSize="20" />
                                    </Button>
                                    <Button x:Name="DPlaylist" Style="{StaticResource Lumina.Btn.Icon}" Width="46" Height="46" Margin="0,0,10,0" Click="OnDetailsPlaylist"
                                            ToolTip="Add to playlist" AutomationProperties.Name="Add to playlist">
                                        <ui:SymbolIcon Symbol="TextBulletListAdd24" FontSize="20" />
                                    </Button>
                                    <Button x:Name="DMore" Style="{StaticResource Lumina.Btn.Icon}" Width="46" Height="46" Click="OnDetailsMore"
                                            ToolTip="More options" AutomationProperties.Name="More options">
                                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="20" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="44,0,0,2" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock x:Name="DEpisodeTitle" Style="{StaticResource Lumina.Text.Label}" FontWeight="SemiBold" FontSize="22" Margin="0,0,0,6" Visibility="Collapsed" TextWrapping="Wrap" />
                                <WrapPanel x:Name="DMeta" Margin="0,0,0,10" />
                                <TextBlock x:Name="DOverview" Style="{StaticResource Lumina.Text.Label}" FontWeight="Normal" TextWrapping="Wrap" MaxHeight="112" TextTrimming="CharacterEllipsis"
                                           FontSize="15" LineHeight="22" />
                                <WrapPanel x:Name="DScores" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="DShowBlock" Margin="44,10,44,0" HorizontalAlignment="Stretch">
                        <WrapPanel x:Name="DSeasons" Margin="0,0,0,14" />
                        <TextBlock x:Name="DEpisodesHeading" Text="Episodes" Style="{StaticResource Lumina.Text.Label}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12" />
                        <ListBox x:Name="DEpisodes" ItemContainerStyle="{StaticResource Lumina.Card.Episode}" ItemTemplate="{StaticResource Lumina.EpisodeCard}"
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="-10,-12,-10,-6" SelectionMode="Single" AutomationProperties.Name="Episodes"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 SelectionChanged="OnEpisodeSelected" MouseDoubleClick="OnEpisodeDouble" KeyDown="OnEpisodeKey" PreviewMouseWheel="OnRowWheel">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Margin="10,12,10,18" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                    <StackPanel x:Name="DCastBlock" Margin="44,18,44,0" HorizontalAlignment="Stretch" Visibility="Collapsed">
                        <TextBlock Text="Cast and Crew" Style="{StaticResource Lumina.Text.Label}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Cast and crew" PreviewMouseWheel="OnRowWheel">
                            <ItemsControl x:Name="DCast" ItemTemplate="{StaticResource CastTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <Grid x:Name="DMovieBlock" Margin="44,22,44,48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DFile" Style="{StaticResource Lumina.Text.Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock x:Name="DSpecs" Grid.Column="1" Style="{StaticResource Lumina.Text.Caption}" Margin="24,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Folders -->
            <ScrollViewer x:Name="FoldersPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="36,10,36,48">
                    <TextBlock Text="Folders" Style="{StaticResource Lumina.Text.Page}" Margin="0,0,0,8" />
                    <TextBlock Text="Lumina scans these folders for video. Network paths work too, for example a share on your NAS."
                               Style="{StaticResource Lumina.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,22" />
                    <TextBlock x:Name="FolderUpdated" Style="{StaticResource Lumina.Text.Caption}" Margin="0,0,0,10" />
                    <UniformGrid Columns="3" Margin="0,0,0,18" MaxWidth="640" HorizontalAlignment="Left">
                        <Border Padding="0,6" Margin="0,0,24,0" AutomationProperties.Name="Films in the library">
                            <StackPanel><TextBlock x:Name="StatFilms" Style="{StaticResource Lumina.Text.Page}" FontSize="26" Foreground="{DynamicResource Lumina.Brush.Accent}" /><TextBlock Text="Films" Style="{StaticResource Lumina.Text.Muted}" /></StackPanel>
                        </Border>
                        <Border Padding="0,6" Margin="0,0,24,0" AutomationProperties.Name="TV episodes in the library">
                            <StackPanel><TextBlock x:Name="StatEpisodes" Style="{StaticResource Lumina.Text.Page}" FontSize="26" Foreground="{DynamicResource Lumina.Brush.Accent}" /><TextBlock Text="TV episodes" Style="{StaticResource Lumina.Text.Muted}" /></StackPanel>
                        </Border>
                        <Border Padding="0,6" AutomationProperties.Name="Size of the library">
                            <StackPanel><TextBlock x:Name="StatSize" Style="{StaticResource Lumina.Text.Page}" FontSize="26" Foreground="{DynamicResource Lumina.Brush.Accent}" /><TextBlock Text="On disk" Style="{StaticResource Lumina.Text.Muted}" /></StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <CheckBox x:Name="FolderShowMovies" Content="Show movies" Click="OnKindToggle" Margin="0,0,28,0" />
                        <CheckBox x:Name="FolderShowShows" Content="Show TV shows" Click="OnKindToggle" />
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,22">
                        <Button Content="Add folder" Style="{StaticResource Lumina.Btn.Primary}" Click="OnAddFolder" Margin="0,0,12,8" />
                        <Button Content="Scan now" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnRescan" Margin="0,0,12,8" ToolTip="Look for new, changed and removed files" />
                        <Button x:Name="FolderUnlockBtn" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnFolderUnlock" Margin="0,0,12,8" Visibility="Collapsed" />
                        <Button Content="Refresh metadata" Style="{StaticResource Lumina.Btn.Secondary}" Click="OnRefreshMetadata" Margin="0,0,0,8" ToolTip="Fetch details, scores and pictures again for every title" />
                    </WrapPanel>
                    <Border Style="{StaticResource Lumina.Group}">
                        <Grid>
                            <ItemsControl x:Name="FolderList" ItemTemplate="{StaticResource FolderRow}" />
                            <TextBlock x:Name="FolderEmpty" Text="No folders yet. Add one to get started." Style="{StaticResource Lumina.Text.Muted}"
                                       Margin="20,22" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FolderStatus" Style="{StaticResource Lumina.Text.Caption}" Margin="4,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Playlists -->
            <ScrollViewer x:Name="PlaylistsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="36,10,36,48" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Playlists" Style="{StaticResource Lumina.Text.Page}" Margin="0,0,0,8" />
                    <TextBlock Text="Open several files or a folder, then choose Save in the player's queue to keep them here."
                               Style="{StaticResource Lumina.Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,22" />
                    <Border Style="{StaticResource Lumina.Group}">
                        <Grid>
                            <ItemsControl x:Name="PlaylistList" ItemTemplate="{StaticResource PlaylistRow}" />
                            <TextBlock x:Name="PlaylistEmpty" Text="No playlists yet." Style="{StaticResource Lumina.Text.Muted}" Margin="20,22" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings: the view is built from Settings/Catalog.cs -->
            <Border x:Name="SettingsPage" Margin="36,10,36,0" Visibility="Collapsed" />
        </Grid>

        <!-- mpv child HWND lives here while playing. It covers the sidebar too, and sits below the title bar so the caption buttons stay clickable. -->
        <Border x:Name="Stage" Grid.Row="1" Grid.ColumnSpan="2" Background="Black" Visibility="Collapsed" Panel.ZIndex="2" />
        <!-- For screen readers: the controller's twin (see PlayerMirror). Invisible, never hit by the mouse, only present while a video plays. -->
        <Border x:Name="MirrorHost" Grid.Row="1" Grid.ColumnSpan="2" Panel.ZIndex="3" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>
