<Window x:Class="Lumina.Sync.TraktConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SizeToContent="Height" Width="480" WindowStartupLocation="CenterOwner"
        Title="Connect Trakt" FontFamily="{StaticResource Lumina.Font.Text}">
    <Grid Margin="24">
        <Border CornerRadius="{StaticResource Lumina.Radius.Surface}" Background="{DynamicResource Lumina.Brush.SurfaceRaised}"
                BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" Padding="30,28,30,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="#000000" Direction="270" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Connect Trakt" Style="{StaticResource Lumina.Text.Section}" />
                <TextBlock x:Name="Prompt" Style="{StaticResource Lumina.Text.Muted}" TextWrapping="Wrap" Text="Contacting Trakt" Margin="0,8,0,0" LineHeight="21" />
                <!-- the code is the one thing to read and type, so it gets the whole card -->
                <Border x:Name="CodeBox" Visibility="Collapsed" CornerRadius="{StaticResource Lumina.Radius.Control}" Background="{DynamicResource Lumina.Brush.Surface}"
                        BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" Margin="0,20,0,0" Padding="0,18">
                    <TextBlock x:Name="Code" FontSize="38" FontWeight="SemiBold" FontFamily="{StaticResource Lumina.Font.Mono}"
                               Foreground="{DynamicResource Lumina.Brush.Accent}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock x:Name="Note" Style="{StaticResource Lumina.Text.Caption}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <Button Content="Cancel" Style="{StaticResource Lumina.Btn.Secondary}" HorizontalAlignment="Right" Margin="0,22,0,0" Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
