<Window x:Class="Lumina.MetadataPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Width="660" Height="720" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Lumina.Font.Text}" KeyDown="OnKey">
    <!-- Same card as the other dialogs: a soft shadow needs breathing room around it. -->
    <Grid Margin="24">
        <Border CornerRadius="{StaticResource Lumina.Radius.Surface}" Background="{DynamicResource Lumina.Brush.SurfaceRaised}"
                BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="#000000" Direction="270" />
            </Border.Effect>
            <Grid Margin="20,18,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- the file this is about -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Lumina.Btn.Icon}" Width="36" Height="36" MinHeight="36" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                    </Button>
                    <TextBlock x:Name="FileText" Grid.Column="1" Style="{StaticResource Lumina.Text.Label}" FontWeight="SemiBold" FontSize="15" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Lumina.Search}" TextChanged="OnSearchChanged" AutomationProperties.Name="Search TMDB" />
                    <ui:SymbolIcon Symbol="Search20" FontSize="16" Foreground="{DynamicResource Lumina.Brush.TextMuted}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="14,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- keep the file's own information -->
                <Button x:Name="NoneBtn" Grid.Row="2" Style="{StaticResource Lumina.Btn.Secondary}" HorizontalContentAlignment="Left" Click="OnNone" Margin="0,0,0,10"
                        AutomationProperties.Name="None, use the file's own information">
                    <TextBlock x:Name="NoneText" Text="None, use the file's own information" FontStyle="Italic" Margin="6,0,0,0" />
                </Button>

                <Grid Grid.Row="3">
                    <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Matches" HorizontalContentAlignment="Stretch" SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Control}" Background="Transparent" Padding="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="84" CornerRadius="6" Background="{DynamicResource Lumina.Brush.Surface}" ClipToBounds="True" VerticalAlignment="Top">
                                        <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Lumina.Text.Label}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Lumina.Text.Muted}" FontSize="13" Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding Overview}" Style="{StaticResource Lumina.Text.Muted}" FontSize="12.5" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ui:SymbolIcon Grid.Column="2" Symbol="Checkmark20" FontSize="20" Foreground="{DynamicResource Lumina.Brush.Accent}" VerticalAlignment="Top" Margin="0,4,4,0"
                                                   Visibility="{Binding CurrentVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Lumina.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
