<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:lib="clr-namespace:Lumina.Library"
                    xmlns:app="clr-namespace:Lumina">

    <!-- ===== Shelf and grid item container: no selection chrome, a quiet lift on hover, an accent ring on keyboard focus ===== -->
    <Style x:Key="Lumina.Card.Item" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.4" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <ContentPresenter />
                        <Border x:Name="Ring" IsHitTestVisible="False" CornerRadius="14" Margin="-5"
                                BorderThickness="2" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="{StaticResource Lumina.Motion.Fast}" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="{StaticResource Lumina.Motion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="{StaticResource Lumina.Motion.Base}" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="{StaticResource Lumina.Motion.Base}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocusWithin" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shelf list: transparent, horizontal, no selection colour. -->
    <Style x:Key="Lumina.Shelf.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Lumina.Card.Item}" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
    </Style>

    <!-- Grid list: wraps, page scrolls. -->
    <Style x:Key="Lumina.Grid.List" TargetType="ListBox" BasedOn="{StaticResource Lumina.Shelf.List}">
        <!-- room inside the list's clip edge for the hover lift and the focus ring, cancelled by the negative margin -->
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="-8,-8,-8,0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Lumina.Card.Item}">
                    <Setter Property="Margin" Value="0,0,18,26" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><app:JustifiedWrapPanel /></ItemsPanelTemplate></Setter.Value>
        </Setter>
    </Style>

    <!-- List view: one full-width row per title -->
    <Style x:Key="Lumina.Row.Item" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Control}" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.Surface}" /></Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocusWithin" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lumina.Row.List" TargetType="ListBox" BasedOn="{StaticResource Lumina.Shelf.List}">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Lumina.Row.Item}" />
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Vertical" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Lumina.EntryRow" DataType="{x:Type lib:LibraryEntry}">
        <Grid Margin="10,8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="56" CornerRadius="6" Background="{DynamicResource Lumina.Brush.Surface}" BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" Margin="0,0,16,0">
                <Border CornerRadius="5"><Border.Background><ImageBrush ImageSource="{Binding Poster}" Stretch="UniformToFill" /></Border.Background></Border>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Lumina.Text.Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource Lumina.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding RatingText}" Style="{StaticResource Lumina.Text.Muted}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <ProgressBar Style="{StaticResource Lumina.Progress}" Value="{Binding Percent, Mode=OneWay}" Width="70" Margin="0,0,12,0" VerticalAlignment="Center"
                             Visibility="{Binding Percent, Converter={x:Static app:Conv.PositiveToVisible}}" />
                <ui:SymbolIcon Symbol="Checkmark20" FontSize="16" Foreground="{DynamicResource Lumina.Brush.Accent}" VerticalAlignment="Center"
                               Visibility="{Binding AllWatched, Converter={x:Static app:Conv.BoolToVisible}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===== Poster card (a movie or a whole show) ===== -->
    <DataTemplate x:Key="Lumina.PosterCard" DataType="{x:Type lib:LibraryEntry}">
        <StackPanel Width="{StaticResource Lumina.Size.PosterW}" Background="Transparent">
            <StackPanel.ToolTip>
                <ToolTip Content="{Binding Overview}" Visibility="{Binding Overview, Converter={x:Static app:Conv.NullToCollapsed}}" />
            </StackPanel.ToolTip>
            <Grid Height="{StaticResource Lumina.Size.PosterH}">
                <Grid.Clip><RectangleGeometry Rect="0,0,156,234" RadiusX="10" RadiusY="10" /></Grid.Clip>
                <Border CornerRadius="{StaticResource Lumina.Radius.Poster}" Background="{DynamicResource Lumina.Brush.Surface}"
                        BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" />
                <Border CornerRadius="{StaticResource Lumina.Radius.Poster}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Poster}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <!-- no artwork yet: show the title in the slot instead of a blank box -->
                <TextBlock x:Name="NoArt" Visibility="Collapsed" Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="{StaticResource Lumina.Font.Display}" FontSize="{StaticResource Lumina.FontSize.Subtitle}"
                           FontWeight="Normal" Foreground="{DynamicResource Lumina.Brush.TextMuted}" />
                <Polygon Points="128,0 156,0 156,28" Fill="{DynamicResource Lumina.Brush.AccentFill}"
                         Visibility="{Binding IsFresh, Converter={x:Static app:Conv.BoolToVisible}}" />
                <Border Visibility="{Binding AllWatched, Converter={x:Static app:Conv.BoolToVisible}}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8" Width="24" Height="24" CornerRadius="12" Background="#CC000000">
                    <ui:SymbolIcon Symbol="Checkmark20" FontSize="14" Foreground="{DynamicResource Lumina.Brush.Accent}" />
                </Border>
                <ProgressBar Style="{StaticResource Lumina.Progress}" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Bottom" Margin="10,0,10,9"
                             Visibility="{Binding Percent, Converter={x:Static app:Conv.PositiveToVisible}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Lumina.Text.Label}" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
            <TextBlock Text="{Binding Sub}" Style="{StaticResource Lumina.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Poster}" Value="{x:Null}">
                <Setter TargetName="NoArt" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Genre banner: a backdrop under the genre's own colours, its name across the middle ===== -->
    <DataTemplate x:Key="Lumina.GenreTile" DataType="{x:Type lib:GenreTile}">
        <Grid Width="300" Height="140" Background="Transparent">
            <Border CornerRadius="16" Background="{DynamicResource Lumina.Brush.SurfaceRaised}" />
            <Border CornerRadius="16"><Border.Background><ImageBrush ImageSource="{Binding Backdrop}" Stretch="UniformToFill" /></Border.Background></Border>
            <Border CornerRadius="16" Background="{Binding Overlay}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lumina.Font.Display}" FontSize="24" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270" />
                <TextBlock Text="{Binding CountText}" FontFamily="{StaticResource Lumina.Font.Text}" FontSize="13" Foreground="#E6FFFFFF" TextAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===== Wide card for Continue watching: backdrop still, play glyph on hover, progress along the bottom ===== -->
    <DataTemplate x:Key="Lumina.HeroCard" DataType="{x:Type lib:LibraryEntry}">
        <StackPanel Width="{StaticResource Lumina.Size.HeroW}" Background="Transparent">
            <Grid x:Name="Root" Height="{StaticResource Lumina.Size.HeroH}">
                <Border CornerRadius="{StaticResource Lumina.Radius.Surface}" Background="{DynamicResource Lumina.Brush.Surface}"
                        BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" />
                <Border CornerRadius="{StaticResource Lumina.Radius.Surface}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" AlignmentY="Top" />
                    </Border.Background>
                </Border>
                <TextBlock x:Name="NoArt" Visibility="Collapsed" Text="{Binding Title}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontFamily="{StaticResource Lumina.Font.Display}" FontSize="{StaticResource Lumina.FontSize.Title}"
                           FontWeight="Normal" Foreground="{DynamicResource Lumina.Brush.TextMuted}" />
                <Border CornerRadius="{StaticResource Lumina.Radius.Surface}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.55" />
                            <GradientStop Color="#B3000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="PlayGlyph" Width="52" Height="52" CornerRadius="26" Background="#8C000000" BorderThickness="1" BorderBrush="#66FFFFFF" Opacity="0">
                    <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="22" Foreground="White" Margin="3,0,0,0" />
                </Border>
                <ProgressBar Style="{StaticResource Lumina.Progress}" Value="{Binding HeroPercent, Mode=OneWay}" VerticalAlignment="Bottom" Margin="14,0,14,12"
                             Visibility="{Binding HeroPercent, Converter={x:Static app:Conv.PositiveToVisible}}" />
            </Grid>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Lumina.Text.Label}" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
            <TextBlock Text="{Binding HeroSub}" Style="{StaticResource Lumina.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HeroImage}" Value="{x:Null}">
                <Setter TargetName="NoArt" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Setter TargetName="PlayGlyph" Property="Opacity" Value="1" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Episode card: the episode's picture, an accent corner while it is new, progress along the bottom ===== -->
    <DataTemplate x:Key="Lumina.EpisodeCard" DataType="{x:Type lib:MediaItem}">
        <StackPanel Width="218" Background="Transparent">
            <Grid Width="218" Height="123">
                <Grid.Clip><RectangleGeometry Rect="0,0,218,123" RadiusX="14" RadiusY="14" /></Grid.Clip>
                <Border Background="{DynamicResource Lumina.Brush.SurfaceRaised}" />
                <TextBlock Text="{Binding EpisodeNumber}" FontFamily="{StaticResource Lumina.Font.Display}" FontSize="34" FontWeight="SemiBold"
                           Foreground="{DynamicResource Lumina.Brush.TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border><Border.Background><ImageBrush ImageSource="{Binding Still}" Stretch="UniformToFill" /></Border.Background></Border>
                <Polygon Points="190,0 218,0 218,28" Fill="{DynamicResource Lumina.Brush.AccentFill}"
                         Visibility="{Binding IsFresh, Converter={x:Static app:Conv.BoolToVisible}}" />
                <ProgressBar Style="{StaticResource Lumina.Progress}" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Bottom" Margin="10,0,10,9"
                             Visibility="{Binding Percent, Converter={x:Static app:Conv.PositiveToVisible}}" />
            </Grid>
            <TextBlock Text="{Binding RowTitle}" Style="{StaticResource Lumina.Text.Label}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="2,9,2,0" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Lumina.Card.Episode" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding RowTitle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <ContentPresenter />
                        <!-- the ring sits on the picture only (the caption is below it) -->
                        <Border x:Name="Ring" IsHitTestVisible="False" CornerRadius="16" Margin="-4,-4,-4,0" Height="131" VerticalAlignment="Top"
                                BorderThickness="3" BorderBrush="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.AccentFill}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
