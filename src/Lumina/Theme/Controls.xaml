<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:app="clr-namespace:Lumina">
    <!-- Lumina control styles. Everything reads from Tokens.xaml; no raw colours here.
         Shape rule: interactive things are pills, surfaces are 14, inputs are 10, posters are 10. -->

    <!-- ===== WPF-UI overrides: the window shell and a few of its controls read these keys ===== -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Lumina.Color.Bg}" />
    <Color x:Key="ApplicationBackgroundColor">#FF0C0D10</Color>
    <!-- page colour with transparency, for fades into the page; and the scrollbar thumb. ThemeManager recolours these. -->
    <Color x:Key="Lumina.Color.BgA90">#E60C0D10</Color>
    <Color x:Key="Lumina.Color.BgA60">#990C0D10</Color>
    <Color x:Key="Lumina.Color.BgA0">#000C0D10</Color>
    <SolidColorBrush x:Key="Lumina.Brush.ScrollThumb" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Lumina.Color.Text}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Lumina.Color.TextMuted}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Lumina.Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Lumina.Color.Border}" />

    <!-- ===== Text ===== -->
    <Style x:Key="Lumina.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Lumina.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text}">
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.TextMuted}" />
    </Style>
    <Style x:Key="Lumina.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text.Muted}">
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Caption}" />
    </Style>
    <Style x:Key="Lumina.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text}">
        <Setter Property="FontWeight" Value="{StaticResource Lumina.FontWeight.Label}" />
    </Style>
    <Style x:Key="Lumina.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text}">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Title}" />
        <Setter Property="FontWeight" Value="{StaticResource Lumina.FontWeight.Title}" />
    </Style>
    <Style x:Key="Lumina.Text.Page" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text}">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Headline}" />
        <Setter Property="FontWeight" Value="{StaticResource Lumina.FontWeight.Headline}" />
    </Style>
    <Style x:Key="Lumina.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Lumina.Text}">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Display}" />
        <Setter Property="FontWeight" Value="{StaticResource Lumina.FontWeight.Display}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- Primary: the one bright pill on a screen (Play / Resume). -->
    <Style x:Key="Lumina.Btn.Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <!-- the most likely action takes the accent, as the Play button in the player does (HIG buttons.md: a prominent style, with the accent as its background) -->
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.Accent}" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource Lumina.Radius.Pill}" Margin="-3"
                                BorderThickness="2" BorderBrush="Transparent" />
                        <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary: quiet pill on a raised surface. -->
    <Style x:Key="Lumina.Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Lumina.Btn.Primary}">
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceRaised}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource Lumina.Radius.Pill}" Margin="-3"
                                BorderThickness="2" BorderBrush="Transparent" />
                        <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: text-only action, accent coloured (See all, Back). -->
    <Style x:Key="Lumina.Btn.Link" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Accent}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="Transparent" Padding="{TemplateBinding Padding}"
                            BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceRaised}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon button (glass over artwork, raised on plain pages). -->
    <Style x:Key="Lumina.Btn.Icon" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="{DynamicResource Lumina.Brush.SurfaceRaised}"
                            BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass icon button for use over backdrops. -->
    <Style x:Key="Lumina.Btn.Glass" TargetType="Button" BasedOn="{StaticResource Lumina.Btn.Icon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="#99000000"
                            BorderThickness="1" BorderBrush="#33FFFFFF">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#CC000000" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Home tile: a raised surface that behaves as one big button. -->
    <Style x:Key="Lumina.Btn.Tile" TargetType="Button">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Surface}" Background="{DynamicResource Lumina.Brush.Surface}"
                            BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceRaised}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.BorderInput}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar navigation item (RadioButton so exactly one is selected) ===== -->
    <Style x:Key="Lumina.Nav.Item" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.TextMuted}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Control}" Background="Transparent"
                            BorderThickness="2" BorderBrush="Transparent" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Glyph" Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <ContentPresenter x:Name="Label" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="app:SidebarMode.IsCompact" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glyph" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="Glyph" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Bg" Property="Padding" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceRaised}" />
                            <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
                            <!-- the current section's icon wears the accent (HIG sidebars.md: sidebar icons use the app's accent color) -->
                            <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented control item ===== -->
    <Style x:Key="Lumina.Seg.Item" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="{StaticResource Lumina.Radius.Pill}" Background="Transparent"
                            BorderThickness="2" BorderBrush="Transparent" Padding="16,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text input ===== -->
    <Style x:Key="Lumina.Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Lumina.Brush.AccentDim}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Lumina.Radius.Control}" Background="{DynamicResource Lumina.Brush.SurfaceRaised}"
                            BorderThickness="1" BorderBrush="{DynamicResource Lumina.Brush.Border}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" />
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Lumina.Brush.TextFaint}" Visibility="Collapsed" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.BorderInput}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar search: same field with a leading magnifier slot. -->
    <Style x:Key="Lumina.Search" TargetType="TextBox" BasedOn="{StaticResource Lumina.Input}">
        <Setter Property="Padding" Value="34,8,12,8" />
    </Style>

    <!-- ===== Progress (thin, accent) ===== -->
    <Style x:Key="Lumina.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.ScrollThumb}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Track">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbars: slim, round, quiet until hovered ===== -->
    <Style x:Key="Lumina.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="{DynamicResource Lumina.Brush.SurfaceHover}" Opacity="0.7" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource Lumina.Brush.BorderInput}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.Thumb><Thumb Style="{StaticResource Lumina.ScrollThumb}" /></Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tooltip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Context menu ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="6">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Lumina.Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource Lumina.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Lumina.Brush.Text}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Lumina.Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Grouped inset list (settings, folders) ===== -->
    <Style x:Key="Lumina.Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Lumina.Radius.Surface}" />
    </Style>
    <Style x:Key="Lumina.Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Lumina.Brush.Border}" />
        <Setter Property="Margin" Value="16,0,0,0" />
    </Style>

    <!-- ===== Switch (settings) ===== -->
    <Style x:Key="Lumina.Toggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource Lumina.Brush.SurfaceHover}" BorderThickness="2" BorderBrush="Transparent">
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource Lumina.Brush.TextMuted}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Lumina.Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Lumina.Brush.OnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.BorderInput}" />
                        </Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="app:FocusMode.Keyboard" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lumina.Brush.Accent}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider (settings) ===== -->
    <Style x:Key="Lumina.Slider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Lumina.Brush.SurfaceHover}" VerticalAlignment="Center" />
                        <Border x:Name="Fill" Height="4" CornerRadius="2" Background="{DynamicResource Lumina.Brush.Accent}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False" AutomationProperties.IsOffscreenBehavior="Offscreen">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                        <Border Background="Transparent" Height="24" />
                                    </ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False" AutomationProperties.IsOffscreenBehavior="Offscreen">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="24" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand" Focusable="False">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Ellipse x:Name="E" Fill="{DynamicResource Lumina.Brush.Text}" Stroke="Transparent" StrokeThickness="3" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="E" Property="Stroke" Value="{DynamicResource Lumina.Brush.AccentDim}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
